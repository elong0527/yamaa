          <arm:AnalysisResult OID="AR.T14.3.01.R1" ParameterOID="IT.ADLB.PARAMCD" AnalysisReason="SPECIFIED IN SAP" AnalysisPurpose="PRIMARY OUTCOME MEASURE">
            <Description>
              <TranslatedText xml:lang="en">Mean glucose of the safety population in treatment group 1</TranslatedText>
            </Description>
            <arm:AnalysisDatasets def:CommentOID="COMA.T14.3.01.R1">
              <arm:AnalysisDataset ItemGroupOID="IG.ADSL">
