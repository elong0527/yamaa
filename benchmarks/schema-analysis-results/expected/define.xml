            <arm:Documentation>
              <Description>
                <TranslatedText xml:lang="en">Glucose is summarised as section 9.2 of the plan describes.</TranslatedText>
              </Description>
              <def:DocumentRef leafID="LF.SAP">
                <def:PDFPageRef PageRefs="Sec9.2" Type="NamedDestination"/>
              </def:DocumentRef>
            </arm:Documentation>
            <arm:ProgrammingCode Context="R 4.5.1">
              <arm:Code>s &lt;- adsl[adsl$SAFFL == "Y" &amp; adsl$TRT01AN == 1, ]
d &lt;- merge(s, adlb[adlb$PARAMCD == "GLUC", ], by = "USUBJID")
mean(d$AVAL)
</arm:Code>
            </arm:ProgrammingCode>
          </arm:AnalysisResult>
        </arm:ResultDisplay>
