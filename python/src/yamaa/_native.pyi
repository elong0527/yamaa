from collections.abc import Callable
from typing import Literal

_CORE_VERSION: str

class DomainError(Exception): ...

class _DomainResult:
    def project_failures(self) -> list[tuple[str, dict]]: ...
    def observations(self) -> str | None: ...
    def output(self) -> bytes | None: ...
    def log(self, warning: bool) -> bytes | None: ...
    def issues(self) -> list[tuple[str, str, str | None, list[str], str]]: ...
    def save(self) -> bool: ...

def _domain_file(
    specification: str, environment: str | None = None
) -> _DomainResult: ...
def _check_project_metadata(
    specification: str, environment: str, language: str
) -> list[tuple]: ...
def _check_file(
    specification: str, environment: str | None = None
) -> list[tuple[str, str, str | None, list[str], str]]: ...

# Private bridge for the optional facade's known temporal result representations.
def _temporal_result(kind: object, fields: object, precision: object) -> object: ...

# Internal bounded original-YAML compiler. Source capture remains explicit host IO.
class _Specification:
    def check_issues(self) -> str: ...
    def build(
        self,
        capture: Callable[
            [str, str, int],
            tuple[bytes, bool]
            | tuple[Literal["missing", "not_regular_file"], BaseException],
        ],
        metadata: tuple[str, str, str, str, str],
        inspect: Callable[
            [str, str],
            None | tuple[Literal["missing", "not_regular_file"], BaseException],
        ]
        | None = None,
    ) -> _BuildResult: ...
    def source(self) -> tuple[str, str]: ...
    def execute_csv(self, source: bytes) -> tuple[bytes | None, str]: ...
    def report(
        self,
        capture: Callable[
            [str, str, int],
            tuple[bytes, bool]
            | tuple[Literal["missing", "not_regular_file"], BaseException],
        ],
        publish: Callable[[str, bytes], None],
        metadata: tuple[str, str, str, str, str],
        inspect: Callable[
            [str, str],
            None | tuple[Literal["missing", "not_regular_file"], BaseException],
        ]
        | None = None,
    ) -> str: ...
    def failure_report(
        self,
        capture: Callable[
            [str, str, int],
            tuple[bytes, bool]
            | tuple[Literal["missing", "not_regular_file"], BaseException],
        ],
        metadata: tuple[str, str, str, str, str],
        inspect: Callable[
            [str, str],
            None | tuple[Literal["missing", "not_regular_file"], BaseException],
        ]
        | None = None,
    ) -> str: ...

def _prepare_specification(
    modules: list[tuple[str, bytes]], entry: int, identity: str, source: bytes
) -> _Specification: ...

class _BuildResult:
    def output(self) -> bytes | None: ...
    def observations(self) -> str: ...
    def save(self, publish: Callable[[str, bytes], None]) -> str: ...

def _prepare_document(
    identity: str,
    source: bytes,
    canonicalize: Callable[[str, str], tuple[str, str] | None],
    capture: Callable[[str, str, int], bytes | None],
    rebase: Callable[[str, str, str, int], str],
) -> _Specification: ...
def _prepare_inherited_specification(
    modules: list[tuple[str, bytes]],
    entry: int,
    identity: str,
    source: bytes,
    canonicalize: Callable[[str, str], tuple[str, str] | None],
    capture: Callable[[str, str, int], bytes | None],
    rebase: Callable[[str, str, str, int], str],
) -> _Specification: ...

# Private owned project service; schema closures and read roots stay explicit.
class DefineError(Exception): ...

class _DefineResult:
    def issues(self) -> list[tuple[str, str, str | None, list[str], str]]: ...
    def artifacts(self) -> list[tuple[str, bytes, str]]: ...
    def capture_reads(self) -> int: ...
    def save(self) -> bool: ...

def _define_file(
    environment: str, standard: str, created: str | None, installed_version: str
) -> _DefineResult: ...

class _ProjectSpecification:
    def preparation_status(self) -> str: ...
    def capture_reads(self) -> int: ...
    def build(self) -> _ProjectAttempt: ...

class _ProjectAttempt:
    def engine_succeeded(self) -> bool: ...
    def result(self, metadata: tuple[str, str, str, str, str]) -> _ProjectResult: ...
    def activation(self) -> str: ...
    def host_failures(self) -> list[tuple[str, BaseException]]: ...
    def failure_facts(self) -> list[tuple[str, dict[str, object]]]: ...
    def prepared_sources(self) -> list[tuple[str, bytes]]: ...
    def study_snapshot(self, index: int) -> bytes | None: ...

class _ProjectResult:
    def report_status(self) -> str: ...
    def output(self) -> bytes | None: ...
    def issues(self) -> list[tuple[str, str, str | None, list[str], str]]: ...
    def observations(self) -> str: ...
    def save(self, publish: Callable[[str, bytes], None]) -> str: ...
    def save_file(self, declared: str, target: str) -> str: ...
    def propagate_interrupt(self) -> None: ...
    def activation(self) -> str: ...
    def host_failures(self) -> list[tuple[str, BaseException]]: ...
    def failure_facts(self) -> list[tuple[str, dict[str, object]]]: ...
    def prepared_sources(self) -> list[tuple[str, bytes]]: ...
    def study_snapshot(self, index: int) -> bytes | None: ...

def _prepare_file_project(
    project_root: str,
    base_directory: str,
    entry: str,
    environment: str,
    data_roots: list[str],
    specification_modules: list[tuple[str, bytes]],
    specification_entry: int,
    environment_modules: list[tuple[str, bytes]],
    environment_entry: int,
) -> _ProjectSpecification: ...
