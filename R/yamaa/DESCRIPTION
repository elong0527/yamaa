Package: yamaa
Title: Clinical Data Specifications with the Shared Rust Engine
Version: 0.4.0
Authors@R: c(
    person("Yilong", "Zhang", email = "elong0527@gmail.com", role = c("aut", "cre")),
    person("Ming-Chun", "Chen", role = "ctb"),
    person("Peng", "Zhang", role = "ctb"),
