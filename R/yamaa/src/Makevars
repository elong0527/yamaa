# The shared Rust engine builds as a static library linked into yamaa.so.
#
# CRAN's Repository Policy and its guidance for packages that use Rust shape
# this build. Cargo reads the locked crates from rust/vendor.tar.xz, never the
# network (--offline), runs at most two jobs (-j 2), and keeps its home below
# rust/target, so the build writes nothing outside this tree and the temporary
# directory. Cargo runs from here rather than from rust/, so rustup ignores the
# bundled rust-toolchain.toml and never installs a toolchain: the build uses
# the caller's Cargo and rustc. Paths are relative to this directory, where
# make and Cargo run.
CARGO_TARGET_DIR = rust/target
CARGO_HOME_DIR = $(CARGO_TARGET_DIR)/cargo-home
RUST_LIB = $(CARGO_TARGET_DIR)/release/libyamaa_r.a
PKG_LIBS = $(RUST_LIB)

all: $(SHLIB) rust_clean

$(SHLIB): $(RUST_LIB)

# Cargo and rustc may sit in ~/.cargo/bin, outside the PATH R was started with.
# Their versions go to the installation log before compilation starts. cc-rs
# otherwise selects the current SDK's minimum macOS version for the codec C
# objects, which can be newer than R's link target: match Rust's arm64 floor
# unless the caller sets one.
$(RUST_LIB): FORCE
	@PATH="$(PATH):$(HOME)/.cargo/bin"; export PATH; \
	if command -v cargo > /dev/null 2>&1 && command -v rustc > /dev/null 2>&1; then :; else \
	  echo "yamaa needs Cargo and rustc 1.82 or later. Install them with the system's"; \
	  echo "package manager, for example 'apt-get install cargo rustc' or"; \
	  echo "'dnf install cargo', or with rustup from https://rustup.rs/."; \
	  exit 1; \
	fi; \
	echo "using `rustc --version`"; \
	echo "using `cargo --version`"; \
	set -- `rustc --version | sed 's/^rustc \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/'`; \
	if [ "$$1" -gt 1 ] 2> /dev/null || { [ "$$1" -eq 1 ] && [ "$$2" -ge 82 ]; } 2> /dev/null; then :; else \
	  echo "yamaa needs rustc 1.82 or later. Update Rust, for example with 'rustup update'."; \
	  exit 1; \
	fi
	rm -rf "$(CARGO_HOME_DIR)" "$(CARGO_TARGET_DIR)/vendor"
	mkdir -p "$(CARGO_HOME_DIR)"
	"$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" --vanilla -e 'untar("rust/vendor.tar.xz", exdir = "$(CARGO_TARGET_DIR)", tar = "internal")'
	cp rust/vendor-config.toml "$(CARGO_HOME_DIR)/config.toml"
	@PATH="$(PATH):$(HOME)/.cargo/bin"; export PATH; \
	if [ "`uname -s`" = Darwin ]; then \
	  MACOSX_DEPLOYMENT_TARGET="$${MACOSX_DEPLOYMENT_TARGET:-11.0}"; export MACOSX_DEPLOYMENT_TARGET; \
	fi; \
	set -x; \
	CARGO_HOME="$(CARGO_HOME_DIR)" CARGO_TARGET_DIR="$(CARGO_TARGET_DIR)" \
	  cargo build --locked --offline -j 2 --release --manifest-path rust/Cargo.toml -p yamaa-r

.PHONY: clean rust_clean FORCE
FORCE:

# Release build intermediates, the unpacked crates and the Cargo home are not
# package objects. Match rextendr's post-link cleanup.
rust_clean: $(SHLIB)
	rm -rf rust/target

clean:
	rm -rf rust/target
