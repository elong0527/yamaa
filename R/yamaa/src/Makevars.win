# Rtools45 uses GCC/MinGW-w64 and UCRT for x86_64 R. Select the GNU Rust
# target explicitly even when the caller's rustup host defaults to MSVC.
#
# As in Makevars, Cargo reads the locked crates from rust/vendor.tar.xz, never
# the network (--offline), runs at most two jobs (-j 2), keeps its home below
# rust/target, and runs from here, so rustup ignores the bundled
# rust-toolchain.toml and builds with the caller's toolchain.
RUST_TARGET = x86_64-pc-windows-gnu
CARGO_TARGET_DIR = $(CURDIR)/rust/target
CARGO_HOME_DIR = $(CARGO_TARGET_DIR)/cargo-home
RUST_LIB = $(CARGO_TARGET_DIR)/$(RUST_TARGET)/release/libyamaa_r.a
PKG_LIBS = "$(RUST_LIB)" -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB) rust_clean

$(SHLIB): $(RUST_LIB)

# Cargo and rustc versions go to the installation log before compilation
# starts. Match upstream extendr's GNU/Rtools library discovery: the temporary
# gcc_eh placeholder belongs to the build tree and is removed after linking.
$(RUST_LIB): FORCE
	@if command -v cargo > /dev/null 2>&1 && command -v rustc > /dev/null 2>&1; then :; else \
	  echo "yamaa needs Cargo and rustc 1.90 or later with the x86_64-pc-windows-gnu"; \
	  echo "target. Install them with rustup from https://rustup.rs/, then run"; \
	  echo "'rustup target add x86_64-pc-windows-gnu'."; \
	  exit 1; \
	fi; \
	echo "using `rustc --version`"; \
	echo "using `cargo --version`"; \
	set -- `rustc --version | sed 's/^rustc \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/'`; \
	if [ "$$1" -gt 1 ] 2> /dev/null || { [ "$$1" -eq 1 ] && [ "$$2" -ge 90 ]; } 2> /dev/null; then :; else \
	  echo "yamaa needs rustc 1.90 or later. Update Rust, for example with 'rustup update'."; \
	  exit 1; \
	fi
	rm -rf "$(CARGO_HOME_DIR)" "$(CARGO_TARGET_DIR)/vendor"
	mkdir -p "$(CARGO_HOME_DIR)" "$(CARGO_TARGET_DIR)/libgcc_mock"
	touch "$(CARGO_TARGET_DIR)/libgcc_mock/libgcc_eh.a"
	"$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" --vanilla -e 'untar("rust/vendor.tar.xz", exdir = "rust/target", tar = "internal")'
	cp rust/vendor-config.toml "$(CARGO_HOME_DIR)/config.toml"
	CARGO_HOME="$(CARGO_HOME_DIR)" LIBRARY_PATH="$(LIBRARY_PATH);$(CARGO_TARGET_DIR)/libgcc_mock" CC_x86_64_pc_windows_gnu="$(CC)" AR_x86_64_pc_windows_gnu="$(AR)" CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER="$(CC)" RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" CARGO_TARGET_DIR="$(CARGO_TARGET_DIR)" cargo build --locked --offline -j 2 --release --target $(RUST_TARGET) --manifest-path rust/Cargo.toml -p yamaa-r

.PHONY: clean rust_clean FORCE
FORCE:

rust_clean: $(SHLIB)
	rm -rf rust/target

clean:
	rm -rf rust/target
