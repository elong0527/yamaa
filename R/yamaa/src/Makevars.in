# The shared Rust engine builds as a static library linked into yamaa.so.
# configure writes this file as src/Makevars with the Cargo and rustc that
# tools/configure.R found, checked and reported, the target directory, and on
# macOS the deployment target for the C code that crates compile.
#
# CRAN's Repository Policy and its guidance for packages that use Rust shape
# this build. Cargo reads the locked crates from rust/vendor.tar.xz, never the
# network (--offline), and keeps its home below rust/target, so the build
# writes nothing outside this tree and the temporary directory. It runs at
# most two jobs: -j 2, with MAKEFLAGS cleared, because Cargo otherwise joins
# the jobserver of a parallel make and runs as many jobs as make allows.
# The package carries no rust-toolchain.toml, so the build uses the caller's
# toolchain, and RUSTUP_AUTO_INSTALL=0 stops rustup from installing a
# toolchain that such a file in a parent directory names.
#
# The target directory is rust/target. The recipe passes it to Cargo, so a
# CARGO_TARGET_DIR that the caller sets for other projects does not move the
# build. Only YAMAA_R_CARGO_TARGET_DIR, which configure reads, names another:
# an absolute directory where Cargo then builds, keeps its home and unpacks
# the crates, and which the cleanup leaves for the next installation to reuse,
# one installation at a time. The project's CI points it at its Rust cache.
# Without it, configure also writes ISOLATION_ENV and ISOLATION_CONFIG: then
# neither the caller's environment nor a .cargo/config.toml in a parent
# directory can move Cargo's build directory out of the target directory or
# run a rustc wrapper, such as a compiler cache. With it, both are empty.
# Paths are relative to this directory, where make and Cargo run.
#
# The cc crate compiles the C sources that crates carry, ReadStat's and
# zstd's, with R's C compiler, CC, as Makevars.win does with Rtools' compiler:
# the command that compiles entrypoint.c and links yamaa.so. A sanitizer
# build of R, such as R-hub's clang-asan image, adds its -fsanitize flags to
# CC, so they instrument that C as they instrument entrypoint.c. R's CFLAGS,
# the warning and optimization flags for a package's own sources, stay out:
# the crates' build scripts choose the flags of their C.
CARGO = @CARGO@
RUSTC = @RUSTC@
CARGO_ENV = @CARGO_ENV@
CARGO_TARGET_DIR = @CARGO_TARGET_DIR@
ISOLATION_ENV = @ISOLATION_ENV@
ISOLATION_CONFIG = @ISOLATION_CONFIG@
CARGO_HOME_DIR = $(CARGO_TARGET_DIR)/cargo-home
RUST_LIB = $(CARGO_TARGET_DIR)/release/libyamaa_r.a
PKG_LIBS = $(RUST_LIB)

all: $(SHLIB) rust_clean

$(SHLIB): $(RUST_LIB)

$(RUST_LIB): FORCE
	rm -rf "$(CARGO_HOME_DIR)" "$(CARGO_TARGET_DIR)/vendor"
	mkdir -p "$(CARGO_HOME_DIR)"
	"$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" --vanilla -e 'untar("rust/vendor.tar.xz", exdir = "$(CARGO_TARGET_DIR)", tar = "internal")'
	cp rust/vendor-config.toml "$(CARGO_HOME_DIR)/config.toml"
	MAKEFLAGS= MFLAGS= CARGO_MAKEFLAGS= RUSTUP_AUTO_INSTALL=0 $(CARGO_ENV) $(ISOLATION_ENV) \
	  CARGO_HOME="$(CARGO_HOME_DIR)" CARGO_TARGET_DIR="$(CARGO_TARGET_DIR)" RUSTC="$(RUSTC)" CC="$(CC)" \
	  "$(CARGO)" build --locked --offline -j 2 --release --manifest-path rust/Cargo.toml -p yamaa-r $(ISOLATION_CONFIG)

.PHONY: clean rust_clean FORCE
FORCE:

# Release build intermediates, the unpacked crates and the Cargo home are not
# package objects. Match rextendr's post-link cleanup.
rust_clean: $(SHLIB)
	rm -rf rust/target

clean:
	rm -rf rust/target
