# Rtools42 and later use GCC/MinGW-w64 and UCRT for x86_64 R. Select the GNU Rust
# target explicitly even when the caller's rustup host defaults to MSVC.
# configure.win writes this file as src/Makevars.win with the Cargo and rustc
# that tools/configure.R found, checked and reported, and the target directory.
#
# As in Makevars.in, Cargo reads the locked crates from rust/vendor.tar.xz,
# never the network (--offline), runs at most two jobs (-j 2, with MAKEFLAGS
# cleared so that Cargo does not join make's jobserver), keeps its home below
# rust/target, and builds with the caller's toolchain: the package carries no
# rust-toolchain.toml, and rustup installs no toolchain (RUSTUP_AUTO_INSTALL=0).
# The target directory is rust/target unless YAMAA_R_CARGO_TARGET_DIR names
# another, as in Makevars.in. configure writes it twice: CARGO_TARGET_DIR is
# absolute, and UNTAR_DIR, for untar(), is relative by default, so that no
# path of the build tree enters the R expression. Unless that variable is
# set, ISOLATION_ENV and ISOLATION_CONFIG keep Cargo's build directory in the
# target directory and run no rustc wrapper, as in Makevars.in. ISOLATION_ENV
# names that directory relatively too, because Cargo reads the build
# directory as a template.
RUST_TARGET = x86_64-pc-windows-gnu
CARGO = @CARGO@
RUSTC = @RUSTC@
CARGO_TARGET_DIR = @CARGO_TARGET_DIR@
UNTAR_DIR = @UNTAR_DIR@
ISOLATION_ENV = @ISOLATION_ENV@
ISOLATION_CONFIG = @ISOLATION_CONFIG@
CARGO_HOME_DIR = $(CARGO_TARGET_DIR)/cargo-home
RUST_LIB = $(CARGO_TARGET_DIR)/$(RUST_TARGET)/release/libyamaa_r.a
OBJCOPY ?= $(BINPREF)objcopy
# Cargo links nothing of the static library. It links the build scripts and
# procedural macros, which it builds for the host, with this linker only when
# the host is x86_64-pc-windows-gnu, as on CRAN's Windows machines. Cargo runs
# the linker as one program, so it gets the first word of R's CC: the CC of
# R's Makeconf ends in a space, and no program is called "gcc ". The cc crate
# splits CC_x86_64_pc_windows_gnu into words, so that keeps the whole command.
RUST_LINKER = $(firstword $(CC))
PKG_LIBS = "$(RUST_LIB)" -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB) rust_clean

$(SHLIB): $(RUST_LIB) rust_exports

# Rtools42's linker cannot read Rust's COFF auto-export exclusions. The DLL's
# exports belong to yamaa-win.def, so remove the object directives before R
# links, retaining the archive's code, data, symbols and debug information.
# objcopy extracts members beside its input; use the temporary directory to
# keep their paths below Windows' limit in R's deeply nested build directory.
rust_exports: $(RUST_LIB)
	set -eu; \
	exports_dir=$$(mktemp -d); \
	trap 'rm -rf "$$exports_dir"' EXIT HUP INT TERM; \
	cp "$(RUST_LIB)" "$$exports_dir/libyamaa_r.a"; \
	$(OBJCOPY) --remove-section=.drectve "$$exports_dir/libyamaa_r.a"; \
	cp "$$exports_dir/libyamaa_r.a" "$(RUST_LIB)"

# Match upstream extendr's GNU/Rtools library discovery: the temporary
# gcc_eh placeholder belongs to the build tree and is removed after linking.
$(RUST_LIB): FORCE
	rm -rf "$(CARGO_HOME_DIR)" "$(CARGO_TARGET_DIR)/vendor"
	mkdir -p "$(CARGO_HOME_DIR)" "$(CARGO_TARGET_DIR)/libgcc_mock"
	touch "$(CARGO_TARGET_DIR)/libgcc_mock/libgcc_eh.a"
	"$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" --vanilla -e 'untar("rust/vendor.tar.xz", exdir = "$(UNTAR_DIR)", tar = "internal")'
	cp rust/vendor-config.toml "$(CARGO_HOME_DIR)/config.toml"
	MAKEFLAGS= MFLAGS= CARGO_MAKEFLAGS= RUSTUP_AUTO_INSTALL=0 $(ISOLATION_ENV) CARGO_HOME="$(CARGO_HOME_DIR)" LIBRARY_PATH="$(LIBRARY_PATH);$(CARGO_TARGET_DIR)/libgcc_mock" CC_x86_64_pc_windows_gnu="$(CC)" AR_x86_64_pc_windows_gnu="$(AR)" CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER="$(RUST_LINKER)" RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" CARGO_TARGET_DIR="$(CARGO_TARGET_DIR)" RUSTC="$(RUSTC)" "$(CARGO)" build --locked --offline -j 2 --release --target $(RUST_TARGET) --manifest-path rust/Cargo.toml -p yamaa-r $(ISOLATION_CONFIG)

.PHONY: clean rust_clean rust_exports FORCE
FORCE:

rust_clean: $(SHLIB)
	rm -rf rust/target

clean:
	rm -rf rust/target
