useDynLib(yamaa, .registration = TRUE)
export(yamaa_domain)
export(yamaa_check)
S3method(as.character,yamaa_int64_vector)
S3method(as.double,yamaa_int64_vector)
S3method(as.integer,yamaa_int64_vector)
S3method("[",yamaa_int64_vector)
S3method("[[",yamaa_int64_vector)
S3method(is.na,yamaa_utf8_vector)
S3method("[",yamaa_utf8_vector)
S3method(as.character,yamaa_int64)
S3method(as.double,yamaa_int64)
S3method(as.integer,yamaa_int64)
S3method(format,yamaa_int64)
S3method(print,yamaa_int64)
S3method(Ops,yamaa_int64)
S3method(Ops,yamaa_int64_vector)
S3method(as.character,yamaa_utf8)
S3method(format,yamaa_utf8)
S3method(print,yamaa_utf8)
S3method(Ops,yamaa_utf8)
S3method(is.na,yamaa_int64)
S3method(is.na,yamaa_utf8)
