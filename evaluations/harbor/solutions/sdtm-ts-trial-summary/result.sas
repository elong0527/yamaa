proc import datafile='/app/input/protocol.csv' out=protocol dbms=csv replace;
  getnames=yes;
run;

data ts;
  length DOMAIN $2 STUDYID $200 TSSEQ 8 TSPARMCD $8 TSPARM $40 TSVAL $1000 TSVALCD $20 TSVCDREF $20;
  set protocol;
  DOMAIN='TS';
  STUDYID=Study;
  TSSEQ=1;
  TSPARMCD='TITLE';
  TSPARM='Trial Title';
  TSVAL=Title;
  TSVALCD='';
  TSVCDREF='';
  output;
  TSSEQ=2;
  TSPARMCD='TPHASE';
  TSPARM='Trial Phase Classification';
  if Phase='Phase 2' then do;
    TSVAL='PHASE II TRIAL';
    TSVALCD='C15601';
  end;
  TSVCDREF='CDISC';
  output;
  TSSEQ=3;
  TSPARMCD='RANDOM';
  TSPARM='Trial is Randomized';
  if Randomized='Yes' then do;
    TSVAL='Y';
    TSVALCD='C49488';
  end;
  TSVCDREF='CDISC';
  output;
  TSSEQ=4;
  TSPARMCD='PLANSUB';
  TSPARM='Planned Number of Subjects';
  TSVAL=strip(put(PlannedSubjects, 12.));
  TSVALCD='';
  TSVCDREF='';
  output;
  keep DOMAIN STUDYID TSSEQ TSPARMCD TSPARM TSVAL TSVALCD TSVCDREF;
run;

proc export data=ts outfile='/app/output/ts.csv' dbms=csv replace;
run;
