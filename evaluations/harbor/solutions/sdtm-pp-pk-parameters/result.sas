data source;
  length Protocol $100 Subject $100 Analyte $100 Parameter $40 Estimate $100 Unit $40 ReferenceDose $40;
  infile '/app/input/nca_transfer.csv' dsd dlm=',' firstobs=2 truncover;
  input Protocol $ Subject $ Analyte $ Parameter $ Estimate $ Unit $ ReferenceDose $;
run;
data mapped;
  length DOMAIN $2 STUDYID $100 USUBJID $100 PPTESTCD $8 PPTEST $40 PPCAT $100 PPORRES $100 PPORRESU $10 PPSTRESC $100 PPSTRESU $10 PPSPEC $10 PPRFTDTC $40;
  set source;
  DOMAIN='PP';
  STUDYID=Protocol;
  USUBJID=Subject;
  if Parameter='Cmax' then do;
    PPTESTCD='CMAX'; PPTEST='Max Conc'; PPORRESU='ng/mL';
  end;
  else if Parameter='Tmax' then do;
    PPTESTCD='TMAX'; PPTEST='Time of CMAX Observation'; PPORRESU='h';
  end;
  else if Parameter='AUClast' then do;
    PPTESTCD='AUCLST'; PPTEST='AUC to Last Nonzero Conc'; PPORRESU='h*ng/mL';
  end;
  PPCAT=Analyte;
  PPORRES=Estimate;
  PPSTRESC=Estimate;
  PPSTRESN=input(Estimate,best32.);
  PPSTRESU=PPORRESU;
  PPSPEC='PLASMA';
  PPRFTDTC=ReferenceDose;
run;
proc sort data=mapped;
  by STUDYID USUBJID PPRFTDTC PPCAT PPTESTCD;
run;
data pp;
  retain DOMAIN STUDYID USUBJID PPSEQ PPTESTCD PPTEST PPCAT PPORRES PPORRESU PPSTRESC PPSTRESN PPSTRESU PPSPEC PPRFTDTC;
  set mapped;
  by STUDYID USUBJID;
  if first.USUBJID then PPSEQ=0;
  PPSEQ+1;
  keep DOMAIN STUDYID USUBJID PPSEQ PPTESTCD PPTEST PPCAT PPORRES PPORRESU PPSTRESC PPSTRESN PPSTRESU PPSPEC PPRFTDTC;
run;
proc export data=pp outfile='/app/output/pp.csv' dbms=csv replace;
run;
