          "dm.csv": {
            "base": "dm"
          },
          "spec.yaml": {
            "base": "output_is_input",
            "edits": [
              {
                "from": "path: out.csv",
                "to": "path: ./sub/../dm.csv"
              }
            ]
          }
        },
        "specification": "spec.yaml",
        "directories": [
          "sub"
        ]
      },
      "issues": [
        {
          "phase": "validation",
          "condition": "artifact_path_collision",
          "rule": "OUTPUT-9",
          "spec_paths": [
            "output.path",
            "input.RAW.path"
          ],
          "context": {
            "path": "./sub/../dm.csv"
          }
        }
      ],
      "saved": {}
    },
