            {"from": "\"type\":\"spec\"", "to": "\"rows\":[{\"dataset\":\"DM\",\"derivations\":{\"AGE\":0},\"id\":\"other_source\"}],\"type\":\"spec\""}
          ]},
          "never-read-other.csv": "USUBJID\n",
          "never-read.csv": "StudyOID,MetaDataVersionOID,SubjectKey,StudyEventOID,StudyEventRepeatKey,FormOID,FormRepeatKey,ItemGroupOID,ItemGroupRepeatKey,ItemOID,Value\n"
        },
        "specification": "spec.yaml"
      },
