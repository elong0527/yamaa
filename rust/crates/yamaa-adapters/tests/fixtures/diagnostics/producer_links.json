{
  "about": "A schema link types a stored artifact from its producing specification's output contract (INPUT-10, INPUT-11): the consumer reads the file at its own path, a header or schema other than the producer's output fails, and a consumer may write no file of its producer. The producer counts the seven records of one subject; the consumer reads what it saves. Moved from file_producer_links.rs, whose tests compared the fields each case's compares names.",
  "documents": {
    "producer": "yamaa: \"1.0\"\ntype: spec\ndomain: COUNTED\nkeys: [ID]\ninput: {RAW: {path: ../raw/raw.csv, types: {ID: int, VALUE: int}}}\nrows:\n  - id: counted\n    dataset: RAW\n    group_by: [RAW.ID]\n    derivations: {ID: RAW.ID, VALUE: {aggregate: 'COUNT(RAW.*)'}}\ncolumns:\n  - {name: ID, type: int, label: Identifier}\n  - {name: VALUE, type: int, label: Count}\noutput: {path: ../generated/producer.csv, columns: [ID, VALUE]}\n",
    "consumer": "yamaa: \"1.0\"\ntype: spec\ndomain: ROOT\nkeys: [ID]\ninput: {FIRST: {path: ../generated/producer.csv, schema: ../producer/p.yaml}}\nrows:\n  - id: counted\n    dataset: FIRST\n    group_by: [FIRST.ID, FIRST.VALUE]\n    derivations: {ID: FIRST.ID, SOURCE_COUNT: FIRST.VALUE, VALUE: {aggregate: 'COUNT(FIRST.*)'}}\ncolumns:\n  - {name: ID, type: int, label: Identifier}\n  - {name: SOURCE_COUNT, type: int, label: Original source count}\n  - {name: VALUE, type: int, label: Count}\noutput: {path: ../generated/root.csv, columns: [ID, SOURCE_COUNT, VALUE]}\n",
    "raw": "ID,VALUE\n1,1\n1,2\n1,3\n1,4\n1,5\n1,6\n1,7\n"
  },
  "cases": [
    {
      "case": "a_consumer_built_before_its_producer_is_saved_reads_a_missing_csv_artifact",
      "operation": "build",
      "input": {"files": {"raw/raw.csv": {"base": "raw"}, "producer/p.yaml": {"base": "producer"}, "consumer/root.yaml": {"base": "consumer"}}, "specification": "consumer/root.yaml"},
      "compares": ["condition", "spec_paths"],
      "issues": [{"condition": "resource_path_missing", "spec_paths": ["input.FIRST.path"]}]
    },
    {
      "case": "a_consumer_built_before_its_producer_is_saved_reads_a_missing_parquet_artifact",
      "operation": "build",
      "input": {
        "files": {
          "raw/raw.csv": {"base": "raw"},
          "producer/p.yaml": {"base": "producer", "edits": [{"from": "producer.csv", "to": "producer.parquet"}]},
          "consumer/root.yaml": {"base": "consumer", "edits": [{"from": "producer.csv", "to": "producer.parquet"}]}
        },
        "specification": "consumer/root.yaml"
      },
      "compares": ["condition", "spec_paths"],
      "issues": [{"condition": "resource_path_missing", "spec_paths": ["input.FIRST.path"]}]
    },
    {
      "case": "a_consumer_may_not_write_its_producers_artifact_as_its_output",
      "operation": "build",
      "input": {
        "files": {
          "raw/raw.csv": {"base": "raw"},
          "producer/p.yaml": {"base": "producer"},
          "consumer/root.yaml": {"base": "consumer", "edits": [{"from": "path: ../generated/root.csv", "to": "path: ../generated/producer.csv"}]},
          "generated/producer.csv": "ID,VALUE\n1,7\n"
        },
        "specification": "consumer/root.yaml"
      },
      "compares": ["condition", "spec_paths"],
      "issues": [{"condition": "artifact_path_collision", "spec_paths": ["output.path", "output.path"]}]
    },
    {
      "case": "a_consumer_may_not_write_its_producers_artifact_as_its_report",
      "operation": "build",
      "input": {
        "files": {
          "raw/raw.csv": {"base": "raw"},
          "producer/p.yaml": {"base": "producer"},
          "consumer/root.yaml": {"base": "consumer", "edits": [{"from": "path: ../generated/root.csv", "to": "path: ../generated/root.csv, report: ../generated/producer.csv"}]},
          "generated/producer.csv": "ID,VALUE\n1,7\n"
        },
        "specification": "consumer/root.yaml"
      },
      "compares": ["condition", "spec_paths"],
      "issues": [{"condition": "artifact_path_collision", "spec_paths": ["output.path", "output.report"]}]
    },
    {
      "case": "a_stored_header_in_another_order_mismatches_the_producer_contract",
      "operation": "build",
      "input": {
        "files": {
          "raw/raw.csv": {"base": "raw"},
          "producer/p.yaml": {"base": "producer"},
          "consumer/root.yaml": {"base": "consumer"},
          "generated/producer.csv": "VALUE,ID\n7,1\n"
        },
        "specification": "consumer/root.yaml"
      },
      "compares": ["condition", "rule", "spec_paths", "context.dataset", "context.expected", "context.reordered", "context.missing", "context.extra"],
      "issues": [{"condition": "producer_contract_mismatch", "rule": "INPUT-11", "spec_paths": ["input.FIRST.schema", "input.FIRST.path"], "context": {"dataset": "FIRST", "expected": ["ID", "VALUE"], "reordered": true, "missing": [], "extra": []}}]
    },
    {
      "case": "a_stored_header_without_a_contract_column_mismatches_the_producer_contract",
      "operation": "build",
      "input": {
        "files": {
          "raw/raw.csv": {"base": "raw"},
          "producer/p.yaml": {"base": "producer"},
          "consumer/root.yaml": {"base": "consumer"},
          "generated/producer.csv": "ID\n1\n"
        },
        "specification": "consumer/root.yaml"
      },
      "compares": ["condition", "rule", "spec_paths", "context.dataset", "context.expected", "context.reordered", "context.missing", "context.extra"],
      "issues": [{"condition": "producer_contract_mismatch", "rule": "INPUT-11", "spec_paths": ["input.FIRST.schema", "input.FIRST.path"], "context": {"dataset": "FIRST", "expected": ["ID", "VALUE"], "reordered": false, "missing": ["VALUE"], "extra": []}}]
    },
    {
      "case": "a_stored_header_with_an_extra_column_mismatches_the_producer_contract",
      "operation": "build",
      "input": {
        "files": {
          "raw/raw.csv": {"base": "raw"},
          "producer/p.yaml": {"base": "producer"},
          "consumer/root.yaml": {"base": "consumer"},
          "generated/producer.csv": "ID,VALUE,OTHER\n1,7,x\n"
        },
        "specification": "consumer/root.yaml"
      },
      "compares": ["condition", "rule", "spec_paths", "context.dataset", "context.expected", "context.reordered", "context.missing", "context.extra"],
      "issues": [{"condition": "producer_contract_mismatch", "rule": "INPUT-11", "spec_paths": ["input.FIRST.schema", "input.FIRST.path"], "context": {"dataset": "FIRST", "expected": ["ID", "VALUE"], "reordered": false, "missing": [], "extra": ["OTHER"]}}]
    },
    {
      "case": "a_stored_parquet_column_of_another_type_mismatches_the_producer_contract",
      "operation": "build",
      "input": {
        "files": {
          "raw/raw.csv": {"base": "raw"},
          "producer/p.yaml": {"base": "producer", "edits": [{"from": "producer.csv", "to": "producer.parquet"}]},
          "producer/text.yaml": {"base": "producer", "edits": [{"from": "VALUE: {aggregate: 'COUNT(RAW.*)'}", "to": "VALUE: \"'7'\""}, {"from": "{name: VALUE, type: int, label: Count}", "to": "{name: VALUE, type: str, label: Count}"}, {"from": "producer.csv", "to": "producer.parquet"}]},
          "consumer/root.yaml": {"base": "consumer", "edits": [{"from": "producer.csv", "to": "producer.parquet"}]}
        },
        "directories": ["generated"],
        "built": ["producer/text.yaml"],
        "specification": "consumer/root.yaml"
      },
      "compares": ["condition", "context.reordered", "context.expected_types", "context.actual_types"],
      "issues": [{"condition": "producer_contract_mismatch", "context": {"reordered": false, "expected_types": ["int", "int"], "actual_types": ["int", "str"]}}]
    },
    {
      "case": "a_linked_ordinal_may_not_name_a_field_of_the_contract",
      "operation": "build",
      "input": {
        "files": {
          "raw/raw.csv": {"base": "raw"},
          "producer/p.yaml": {"base": "producer"},
          "consumer/root.yaml": {"base": "consumer", "edits": [{"from": "schema: ../producer/p.yaml", "to": "schema: ../producer/p.yaml, ordinal: ID"}]},
          "generated/producer.csv": "ID,VALUE\n1,7\n2,7\n"
        },
        "specification": "consumer/root.yaml"
      },
      "compares": ["phase", "condition", "rule", "spec_paths"],
      "issues": [{"phase": "validation", "condition": "ordinal_field_collision", "rule": "INPUT-4", "spec_paths": ["input.FIRST.ordinal"]}]
    }
  ]
}
