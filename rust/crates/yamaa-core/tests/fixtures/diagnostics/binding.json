{
  "about": "What binding refuses once each input's schema is known: source reads and their selections, scope and grouping, row filters, windows, named lookups and their nearest selection, and an order term whose field holds types that do not compare (LOOKUP, NAME, ROW-5, ROW-6, FORMULA-9, WINDOW, VALUE-2, VALUE-22); then the column dependency analysis (COLUMN-5 to COLUMN-7), a column window's drivers (WINDOW-11), the verification declarations a prepared specification keeps (CHECK) and a key computed by an aggregate (COLUMN-7). In `value` the column VALUE takes each case's derivation, read from SRC, whose schema is ID and V, both int; `lookup` adds the donor DONOR through the intermediate SEL. In `pairs` the pair relation P pairs the records of L and R on K and exposes ID and RID, which a row template driving on it reads (LOOKUP-27).",
  "documents": {
    "value": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "TEST",
      "base": "SRC",
      "input": {"SRC": {"path": "source.csv"}},
      "keys": ["ID"],
      "columns": [
        {"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}},
        {"name": "VALUE", "type": "int"}
      ],
      "output": {"path": "result.csv", "columns": ["ID", "VALUE"]}
    },
    "lookup": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "TEST",
      "base": "SRC",
      "input": {"SRC": {"path": "source.csv"}, "DONOR": {"path": "donor.csv"}},
      "keys": ["ID"],
      "columns": [
        {"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}},
        {"name": "VALUE", "type": "int", "derivation": {"value": "SEL.V"}}
      ],
      "intermediates": [{"id": "SEL", "dataset": "DONOR", "key": {"DID": "ID"}}],
      "output": {"path": "result.csv", "columns": ["ID", "VALUE"]}
    },
    "pairs": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "TEST",
      "input": {"L": {"path": "l.csv", "types": {"ID": "int"}}, "R": {"path": "r.csv", "types": {"ID": "int"}}},
      "keys": ["ID", "RID"],
      "columns": [{"name": "ID", "type": "int"}, {"name": "RID", "type": "int"}],
      "intermediates": [{"id": "P", "dataset": "L", "inner_join": "R", "key": ["K"], "derivations": {"ID": "L.ID", "RID": "R.ID"}}],
      "rows": [{"id": "pairs", "dataset": "P", "derivations": {"ID": "P.ID", "RID": "P.RID"}}],
      "output": {"path": "result.csv", "columns": ["ID", "RID"]}
    },
    "window_drivers": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "TEST",
      "input": {"DM": {"path": "dm.csv"}, "AE": {"path": "ae.csv"}},
