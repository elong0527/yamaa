      "columns": [
        {"name": "ID", "type": "int"},
        {"name": "VALUE", "type": "int", "derivation": {"value": {"row_number": {"window": {"order_by": ["DM.AGE"]}}}}}
      ],
      "output": {"path": "result.csv", "columns": ["ID", "VALUE"]},
      "rows": [
        {"id": "subjects", "dataset": "DM", "derivations": {"ID": {"value": "DM.ID"}}},
