{
  "about": "The refusals of a specification's named intermediates: a lookup's range and projection (LOOKUP-2, LOOKUP-9, LOOKUP-11), its key's match values, each compared by its one result type with its donor column before any record is matched (LOOKUP-5, LOOKUP-6, LOOKUP-9, TEXT-2), what its derivations and unique verifications read (LOOKUP-15 to LOOKUP-17), and a driver of row templates (ROW-2). `range` is a lookup P of the donor D, `match` a lookup LOOK of the donor TAB, whose key each case writes, read by the column V, `lookup` one of D beside the base SRC, `driver` an intermediate of D that drives the row template `selected`, and `reads` a lookup P whose derivation reads the lookup EARLIER declared before it. A key whose first refusal was read by position pins it as a prefix.",
  "documents": {
    "range": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "TEST",
      "base": "SRC",
      "input": {"SRC": {"path": "src.csv"}, "D": {"path": "donor.csv"}},
      "keys": ["ID"],
      "intermediates": [{"id": "P", "dataset": "D", "key": ["ID"]}],
      "columns": [{"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}}],
      "output": {"path": "out.csv", "columns": ["ID"]}
    },
    "match": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "OUT",
      "base": "SRC",
      "input": {"SRC": {"path": "src.csv", "types": {"N": "int"}}, "TAB": {"path": "tab.csv"}},
      "keys": ["ID"],
      "intermediates": [{"id": "LOOK", "dataset": "TAB", "key": null, "absent": null}],
      "columns": [
        {"name": "ID", "type": "str", "derivation": {"value": "SRC.ID"}},
        {"name": "N", "type": "int", "derivation": {"value": "SRC.N"}},
        {"name": "V", "type": "str", "derivation": {"value": "LOOK.VAL"}}
      ],
      "output": {"path": "out.csv", "columns": ["ID", "N", "V"]}
    },
    "lookup": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "OUT",
      "base": "SRC",
      "keys": ["ID"],
      "input": {"SRC": {"path": "src.csv"}, "D": {"path": "d.csv"}},
      "intermediates": [{"id": "P", "dataset": "D", "key": ["ID"]}],
      "output": {"path": "out.csv", "columns": ["ID"]},
      "columns": [{"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}}]
    },
    "driver": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "OUT",
      "base": "SRC",
      "keys": ["ID"],
      "input": {"SRC": {"path": "src.csv"}, "D": {"path": "d.csv"}},
      "intermediates": [{"id": "P", "dataset": "D"}],
      "output": {"path": "out.csv", "columns": ["ID"]},
      "columns": [{"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}}],
      "rows": [{"id": "selected", "dataset": "P", "derivations": {"ID": {"value": "P.ID"}}}]
    },
    "reads": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "OUT",
      "base": "SRC",
      "keys": ["ID"],
      "input": {"SRC": {"path": "src.csv"}, "D": {"path": "d.csv"}},
      "intermediates": [
        {"id": "EARLIER", "dataset": "SRC", "key": {"ID": "D.ABSENT"}},
        {"id": "P", "dataset": "D", "key": ["ID"], "derivations": {"NEXT": {"value": "EARLIER.ID"}}}
      ],
      "output": {"path": "out.csv", "columns": ["ID"]},
      "columns": [{"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}}]
    },
    "row_context": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "TEST",
      "input": {"SRC": {"path": "src.csv", "key": ["ID"]}, "DONOR": {"path": "donor.csv"}},
      "keys": ["ID"],
      "intermediates": [{"id": "P", "dataset": "DONOR", "key": {"K": "KEY"}, "absent": null}],
      "columns": [
        {"name": "ID", "type": "str", "derivation": {"value": "SRC.ID"}},
        {"name": "KEY", "type": "str", "derivation": {"value": "SRC.K"}},
        {"name": "ROWV", "type": "str"},
        {"name": "COLV", "type": "str", "derivation": {"value": "P.V"}}
      ],
      "rows": [
        {"id": "first", "derivations": {"ROWV": {"value": "P.V"}}, "dataset": "SRC"},
        {"id": "second", "derivations": {"ROWV": {"value": "P.V"}}, "dataset": "SRC"}
      ],
      "output": {"path": "out.csv", "columns": ["ID", "KEY", "ROWV", "COLV"]}
    }
  },
  "cases": [
    {
      "case": "a_lookup_range_with_neither_bound_is_refused",
      "operation": "prepare",
      "input": {
        "base": "range",
        "edits": [{"set": ["intermediates", "0", "between"], "to": {"value": "ID"}}]
      },
      "issues": [{"phase": "validation", "condition": "invalid_field_type", "rule": "LOOKUP-9", "spec_paths": ["intermediates.P.between"], "context": {"intermediate": "P", "expected": "at least one of lower, upper"}}]
    },
