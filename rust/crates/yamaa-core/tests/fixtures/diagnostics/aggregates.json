      "input": {"finding": "invalid_context", "path": "aggregate", "expression": "SUM(V)", "cause": "output_needs_groups"},
      "compares": ["phase", "condition", "rule", "context", "source_span", "operand_route"],
      "issues": [{"phase": "validation", "condition": "invalid_aggregate_context", "rule": "LOOKUP-19", "context": {"expr": "SUM(V)", "reason": "an output-row reduction declares group_by"}}]
    },
    {
      "case": "a_qualified_group_that_is_no_output_key_has_no_aggregate_context",
