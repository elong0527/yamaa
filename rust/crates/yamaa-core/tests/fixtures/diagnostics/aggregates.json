      "issues": [{"phase": "validation", "condition": "incompatible_input_type", "rule": "FORMULA-23", "spec_paths": ["columns.X.aggregate"], "context": {"expr": "SUM(EX.DOSE) + KEY", "source": "KEY", "expected": "numeric", "actual": "str"}, "source_span": {"start": 15, "end": 18}, "operand_route": ["right"]}]
    },
    {
