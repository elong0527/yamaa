        ],
        "project": {"language": "python", "codelists": [{"codelists": [{"id": "SEX", "name": "Sex", "items": [{"value": "F"}]}]}]}
      },
      "compares": ["phase", "condition", "rule", "spec_paths"],
      "issues": [{"phase": "validation", "condition": "reserved_metadata_key", "rule": "SUB-2", "spec_paths": ["columns.CODE.metadata.codelist"]}]
    },
    {
