      "operation": "codelist_binding",
      "input": {
        "codelists": [{"id": "CODE", "name": "Codes", "data_type": "text", "extensible": false, "external": {"dictionary": "dictionary", "version": "1", "href": "relative/path"}}],
        "bindings": [{"column": 1, "name": "VALUE", "kind": "int", "path": "columns.VALUE.submission.codelist", "codelist": "CODE", "allowed_values": ["allowed"]}]
      },
      "compares": ["condition", "spec_paths"],
