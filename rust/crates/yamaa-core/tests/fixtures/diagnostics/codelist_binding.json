      "input": {
        "codelists": [{"id": "CODE", "name": "Codes", "data_type": "text", "extensible": false, "external": {"dictionary": "dictionary", "version": "1", "href": "relative/path"}}],
        "bindings": [{"column": 1, "name": "VALUE", "kind": "str", "path": "columns.VALUE.submission.codelist", "codelist": "CODE", "allowed_values": ["allowed"]}]
      },
      "issues": []
    },
    {
