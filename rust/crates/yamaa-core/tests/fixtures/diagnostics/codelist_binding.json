      },
      "compares": ["condition", "spec_paths", "context.stated_by"],
      "issues": [{"condition": "redundant_declaration", "spec_paths": ["columns.CODE.verifications[0].allowed_values"], "context": {"stated_by": "columns.CODE.submission.codelist"}}]
    },
    {
      "case": "submission_claims_are_admitted_and_reserved_metadata_has_a_registered_cause",
