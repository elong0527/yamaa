{
  "about": "Binding a specification's codelists to the project's catalogue: a codelist the catalogue does not hold (CT-1), one whose data type the column's type does not admit (CT-8), and an allowed_values verification that restates a bound codelist's items (CT-9), every fault reported in order. `codelist_binding` binds directly against a catalogue of one source, where a codelist names an external dictionary in place of its items; `prepare_in` prepares `coded`, whose CODE column binds the codelist SEX beside its submission origins under the ADaM model (SUB-3, SUB-15), in a 1.0 project run by the Python host whose one codelist file declares SEX, holding the value F, and reports what preparation refuses, the reserved metadata a coded specification cannot declare (SUB-2) among it. It also binds the codelist each `decode` reads (EXPR-15): `decoded` derives SEXDESC by decoding SRC.SEX through SEX, and preparation refuses a codelist the project does not declare and one that declares no decode, whether its items have none or it names an external dictionary, while binding refuses a source of another type than the one the codelist's data type is held in. A case compares the fields its table compared.",
  "documents": {
    "coded": {
      "yamaa": "1.0",
      "type": "spec",
      "model": "ADaM",
      "domain": "TEST",
      "input": {"SRC": {"path": "input.csv"}},
      "keys": ["ID"],
      "columns": [
        {"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}},
        {"name": "CODE", "type": "str", "derivation": {"value": "SRC.CODE"}, "submission": {"codelist": "SEX", "origins": [{"type": "Assigned"}]}},
        {"name": "LATE", "type": "int", "derivation": {"value": "SRC.LATE"}}
      ],
      "output": {"path": "output.csv", "columns": ["ID", "CODE", "LATE"]}
    },
    "decoded": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "TEST",
      "input": {"SRC": {"path": "input.csv"}},
      "keys": ["ID"],
      "columns": [
        {"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}},
        {"name": "SEXDESC", "type": "str", "derivation": {"value": {"decode": {"source": "SRC.SEX", "codelist": "SEX"}}}}
      ],
      "output": {"path": "output.csv", "columns": ["ID", "SEXDESC"]}
    }
  },
  "cases": [
    {
      "case": "every_codelist_binding_fault_is_reported_in_binding_order",
      "operation": "codelist_binding",
      "input": {
        "codelists": [{"id": "SEX", "name": "Sex", "data_type": "text", "extensible": false, "items": ["F"]}],
        "bindings": [
          {"column": 0, "name": "X", "kind": "str", "path": "columns.X.submission.codelist", "codelist": "UNKNOWN", "allowed_values": []},
          {"column": 0, "name": "X", "kind": "int", "path": "columns.X.submission.codelist", "codelist": "SEX", "allowed_values": ["columns.X.verifications[0].allowed_values"]}
        ]
      },
      "compares": ["phase", "condition", "rule"],
      "issues": [
        {"phase": "validation", "condition": "unknown_codelist", "rule": "CT-1"},
        {"phase": "validation", "condition": "codelist_type_mismatch", "rule": "CT-8"},
        {"phase": "validation", "condition": "redundant_declaration", "rule": "CT-9"}
      ]
    },
    {
      "case": "complete_static_findings_preserve_all_bindings_and_name_the_redundant_verification",
      "operation": "codelist_binding",
      "input": {
        "codelists": [{"id": "CODE", "name": "Codes", "data_type": "text", "extensible": false, "items": ["F", "M\u0000\ud83d\ude42"]}],
        "bindings": [
          {"column": 1, "name": "VALUE", "kind": "str", "path": "columns.VALUE.submission.codelist", "codelist": "UNKNOWN", "allowed_values": []},
          {"column": 1, "name": "VALUE", "kind": "int", "path": "columns.VALUE.submission.codelist", "codelist": "CODE", "allowed_values": ["columns.VALUE.verifications[0].allowed_values"]}
        ]
      },
      "compares": ["phase", "condition", "rule", "spec_paths", "context"],
      "issues": [
        {"phase": "validation", "condition": "unknown_codelist", "rule": "CT-1", "spec_paths": ["columns.VALUE.submission.codelist"], "context": {"column": "VALUE", "codelist": "UNKNOWN"}},
        {"phase": "validation", "condition": "codelist_type_mismatch", "rule": "CT-8", "spec_paths": ["columns.VALUE.submission.codelist"], "context": {"column": "VALUE", "codelist": "CODE", "codelist_data_type": "text", "column_type": "int"}},
        {"phase": "validation", "condition": "redundant_declaration", "rule": "CT-9", "spec_paths": ["columns.VALUE.verifications[0].allowed_values"], "context": {"column": "VALUE", "codelist": "CODE", "stated_by": "columns.VALUE.submission.codelist"}}
      ]
    },
    {
      "case": "a_fixed_binding_rejects_every_verification_that_restates_its_value_set",
      "operation": "codelist_binding",
      "input": {
        "codelists": [{"id": "CODE", "name": "Codes", "data_type": "float", "extensible": false, "items": [9007199254740993, -0.0]}],
        "bindings": [{"column": 1, "name": "VALUE", "kind": "float", "path": "columns.VALUE.submission.codelist", "codelist": "CODE", "allowed_values": ["first", "second"]}]
      },
      "compares": ["spec_paths"],
      "issues": [{"spec_paths": ["first"]}, {"spec_paths": ["second"]}]
    },
    {
      "case": "an_extensible_list_of_items_makes_an_allowed_values_verification_redundant",
      "operation": "codelist_binding",
      "input": {
        "codelists": [{"id": "CODE", "name": "Codes", "data_type": "text", "extensible": true, "items": ["F"]}],
        "bindings": [{"column": 1, "name": "VALUE", "kind": "str", "path": "columns.VALUE.submission.codelist", "codelist": "CODE", "allowed_values": ["allowed"]}]
      },
      "compares": ["condition", "spec_paths"],
      "issues": [{"condition": "redundant_declaration", "spec_paths": ["allowed"]}]
    },
    {
