        {"phase": "validation", "condition": "codelist_without_decodes", "rule": "EXPR-15", "spec_paths": ["columns.TERM.derivation.decode.codelist"], "context": {"codelist": "MEDDRA"}}
      ]
    },
    {
      "case": "a_decode_source_of_another_type_than_its_codelist_holds_is_refused_when_bound",
      "operation": "prepare_in",
      "input": {
        "base": "decoded",
        "project": {"language": "python", "codelists": [{"codelists": [{"id": "SEX", "name": "Sex", "items": [{"value": "F", "decode": "Female"}, {"value": "M", "decode": "Male"}]}]}]},
