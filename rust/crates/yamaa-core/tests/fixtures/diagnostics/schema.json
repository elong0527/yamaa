          "case_item_class": {"type": ["case_branch_class", "case_otherwise_class"]},
          "case_branch_class": [{"when": {"type": "str", "required": true}}, {"then": {"type": "int", "required": true}}],
          "case_otherwise_class": [{"otherwise": {"type": "int", "required": true}}]
