          "item_value": {"type": ["str", "item_class"]},
          "item_class": [{"name": {"type": "str", "required": true}}]
        }},
        "document": {"item": {"name": "DM"}}
      },
      "issues": [{"phase": "validation", "condition": "redundant_long_form", "rule": "SCHEMA-15", "spec_paths": ["item"], "context": {"field": "name", "shorthand": "DM"}}]
    },
    {
      "case": "a_registry_value_naming_no_keyword_declares_no_operation",
