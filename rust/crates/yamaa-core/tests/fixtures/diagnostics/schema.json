{
  "about": "The schema language's own findings in a pass over a document or a layer (SCHEMA-7, SCHEMA-12, SCHEMA-13, SCHEMA-15, EXPR-7, VALUE-1, TIME-10, LAYER-4, LAYER-9, WINDOW-1). Each case's schema is one module, schema.yaml, whose entry class is root_class. Most cases find each finding by its cause among those the pass reports; a value that fails a descriptor's values, pattern and minimum length reports exactly those three findings, in the order constraints are checked (values, pattern, minimum length, then exact size). Both compare each finding as its phase, condition, rule and path. A long form restating its shorthand and a layer's covering clear entry are the pass's one finding, compared whole.",
  "cases": [
    {
      "case": "a_class_value_refuses_a_wrong_type_and_an_undeclared_field",
      "operation": "schema_document",
      "input": {
        "schema": {"schema.yaml": {"version": "1.0", "root_class": [{"needed": {"type": "int", "required": true}}]}},
        "document": {"needed": true, "extra": "x"}
      },
      "compares": ["phase", "condition", "rule", "spec_paths"],
      "among": true,
      "issues": [
        {"phase": "validation", "condition": "invalid_field_type", "rule": "SCHEMA-12", "spec_paths": ["needed"]},
        {"phase": "validation", "condition": "unknown_field", "rule": "SCHEMA-13", "spec_paths": ["extra"]}
      ]
    },
    {
      "case": "a_class_value_that_omits_a_required_field_is_missing_it",
      "operation": "schema_document",
      "input": {
        "schema": {"schema.yaml": {"version": "1.0", "root_class": [{"needed": {"type": "int", "required": true}}]}},
        "document": {"extra": "x"}
      },
      "compares": ["phase", "condition", "rule", "spec_paths"],
      "among": true,
      "issues": [{"phase": "validation", "condition": "missing_required_field", "rule": "SCHEMA-13", "spec_paths": ["needed"]}]
    },
    {
