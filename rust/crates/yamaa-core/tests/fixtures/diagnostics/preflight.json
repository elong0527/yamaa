        {"phase": "validation", "condition": "unknown_field", "rule": "TIME-1", "spec_paths": ["columns.SHIFT.derivation.shift.amount"], "context": {"field": "amount", "type": "date", "identifier": "amount"}},
        {"phase": "validation", "condition": "unknown_field", "rule": "TIME-1", "spec_paths": ["columns.SHIFT.derivation.shift.unit"], "context": {"field": "unit", "type": "date", "identifier": "unit"}},
