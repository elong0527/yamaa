      "issues": [{"phase": "validation", "condition": "empty_string_present_unsupported", "rule": "INPUT-9", "spec_paths": ["input.SRC.empty_string"], "context": {"dataset": "SRC"}}]
    },
    {
      "case": "a_transport_input_declares_its_encoding",
