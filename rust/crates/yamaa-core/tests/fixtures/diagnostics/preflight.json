        {"phase": "validation", "condition": "duplicate_derivation", "rule": "SPEC-6", "spec_paths": ["columns.X.derivation"], "context": {"column": "X", "identifier": "X", "rows": ["first", "second", "third"], "not_row_local": "aggregate"}},
