    {
      "case": "without_row_templates_two_inputs_need_a_base",
      "operation": "prepare",
      "input": {"base": "spec", "edits": [{"remove": ["base"]}]},
      "issues": [{"phase": "validation", "condition": "driver_unavailable", "rule": "ROW-8", "spec_paths": ["base"], "context": {"dataset": null, "row": null}}]
