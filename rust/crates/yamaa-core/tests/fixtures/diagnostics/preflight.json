      "issues": [{"phase": "validation", "condition": "unknown_artifact_profile", "rule": "OUTPUT-5", "spec_paths": ["output.report"], "context": {"path": "report.arrow", "permitted": [".csv", ".parquet"]}}]
    },
    {
      "case": "a_warning_verification_needs_a_report_file",
      "operation": "prepare",
      "input": {
        "base": "one_input",
        "edits": [
          {"set": ["input"], "to": {"SRC": {"path": "input.csv"}}},
          {"set": ["verifications"], "to": [{"row_count": {"min": 1, "severity": "warning"}}]}
        ]
      },
      "issues": [{"phase": "validation", "condition": "missing_report", "rule": "CHECK-22", "spec_paths": ["output.report"], "context": {"warnings": ["verifications[0].row_count"]}}]
    },
    {
      "case": "preparation_reports_column_name_key_and_base_refusals_in_that_order",
      "operation": "prepare",
      "input": {
        "base": "spec",
        "edits": [
          {"set": ["domain"], "to": "SRC"},
          {"set": ["keys"], "to": ["MISSING"]},
          {"set": ["columns"], "to": [{"name": "ID", "type": "int"}]},
          {"set": ["base"], "to": "ABSENT"}
        ]
      },
      "issues": [
        {"phase": "validation", "condition": "missing_derivation", "rule": "SPEC-4", "spec_paths": ["columns.ID.derivation"], "context": {"column": "ID"}},
        {"phase": "validation", "condition": "duplicate_identifier", "rule": "NAME-2", "spec_paths": ["input.SRC", "domain"], "context": {"identifier": "SRC"}},
        {"phase": "validation", "condition": "undeclared_column", "rule": "OUTPUT-2", "spec_paths": ["keys[0]"], "context": {"column": "MISSING"}},
        {"phase": "validation", "condition": "driver_unavailable", "rule": "ROW-8", "spec_paths": ["base"], "context": {"dataset": "ABSENT", "row": null}}
      ]
