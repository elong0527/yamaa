        {"phase": "validation", "condition": "invalid_field_type", "rule": "ROW-4", "spec_paths": ["rows.first.group_by"], "context": {"row": "first", "group_by": [], "expected": "at least one driver variable, each once"}},
        {"phase": "validation", "condition": "unknown_field", "rule": "ROW-4", "spec_paths": ["rows.second.group_by"], "context": {"row": "second", "identifier": "SECOND.ID", "dataset": "SRC"}},
        {"phase": "validation", "condition": "driver_unavailable", "rule": "ROW-1", "spec_paths": ["rows.third.dataset"], "context": {"row": "third", "dataset": null}}
