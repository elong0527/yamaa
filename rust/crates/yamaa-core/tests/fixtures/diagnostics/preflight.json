              {"id": "third", "derivations": {"ID": {"value": "SRC.ID"}, "X": {"value": "SRC.ID"}}}
            ]
          }
        ]
      },
      "issues": [
        {"phase": "validation", "condition": "undeclared_column", "rule": "SPEC-5", "spec_paths": ["rows.first.derivations.BOGUS"], "context": {"column": "BOGUS"}},
