{
  "about": "What preparation refuses in a 1.0 specification before any input is read: the declarations of inputs, keys, columns, row templates, named intermediates and the output, and the temporal operations' fields (SPEC, NAME, INPUT, SAS-2, OUTPUT, CSV-6, ROW, LOOKUP, TIME, CHECK-22, VALUE-5); then what output declarations, binding a root filter and admitting a generated ordinal report. The specification `spec` reads two inputs from `base` SRC, and `one_input` reads SRC alone, naming no `base`; each writes one key column ID.",
  "documents": {
    "spec": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "TEST",
      "input": {"SRC": {"path": "source.csv"}, "SECOND": {"path": "second.csv"}},
      "keys": ["ID"],
      "columns": [{"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}}],
      "output": {"path": "result.csv", "columns": ["ID"]},
      "base": "SRC"
    },
    "one_input": {
      "yamaa": "1.0",
      "type": "spec",
      "domain": "TEST",
      "input": {"SRC": {"path": "source.csv"}},
      "keys": ["ID"],
      "columns": [{"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}}],
      "output": {"path": "result.csv", "columns": ["ID"]}
    }
  },
  "cases": [
    {
      "case": "an_integer_literal_past_the_int_range_overflows_before_any_input_is_read",
      "operation": "prepare",
      "input": {"base": "one_input", "edits": [{"set": ["columns", "0", "derivation"], "to": {"value": 9223372036854775808}}]},
      "issues": [{"phase": "validation", "condition": "integer_overflow", "rule": "VALUE-5", "spec_paths": ["columns.ID.derivation"], "context": {"actual": 9223372036854775808, "value": "9223372036854775808", "minimum": -9223372036854775808, "maximum": 9223372036854775807}}]
    },
    {
      "case": "keys_name_at_least_one_column",
      "operation": "prepare",
      "input": {"base": "one_input", "edits": [{"set": ["keys"], "to": []}]},
      "issues": [{"phase": "validation", "condition": "invalid_field_type", "rule": "OUTPUT-2", "spec_paths": ["keys"], "context": {"expected": "at least one key column", "actual": "empty list"}}]
    },
    {
      "case": "keys_name_each_column_once",
      "operation": "prepare",
      "input": {"base": "one_input", "edits": [{"set": ["keys"], "to": ["ID", "ID"]}]},
      "issues": [{"phase": "validation", "condition": "duplicate_identifier", "rule": "OUTPUT-2", "spec_paths": ["keys[1]"], "context": {"identifier": "ID"}}]
    },
    {
      "case": "a_column_name_is_declared_once",
      "operation": "prepare",
      "input": {
        "base": "one_input",
        "edits": [{"set": ["columns"], "to": [{"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}}, {"name": "ID", "type": "int", "derivation": {"value": "SRC.ID"}}]}]
      },
      "issues": [{"phase": "validation", "condition": "duplicate_identifier", "rule": "SPEC-2", "spec_paths": ["columns[1].name"], "context": {"identifier": "ID"}}]
    },
    {
      "case": "an_input_an_odm_read_uses_declares_no_ordinal",
      "operation": "prepare",
      "input": {
        "base": "one_input",
        "edits": [
          {"set": ["input"], "to": {"SRC": {"path": "source.parquet", "ordinal": "REC"}}},
          {"set": ["columns", "0", "derivation"], "to": {"value": {"odm": {"item": "SRC.ITEM"}}}}
        ]
      },
      "issues": [{"phase": "validation", "condition": "odm_schema_field_type", "rule": "INPUT-4", "spec_paths": ["input.SRC.ordinal"], "context": {"dataset": "SRC", "declared": "ordinal"}}]
    },
    {
      "case": "an_input_path_extension_names_a_known_profile",
