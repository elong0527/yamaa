      "updated": 1789848825227,
      "link": null,
      "locked": false,
      "text": "Sections: each builds its rows separately; concatenated in order, must satisfy keys.\nShared columns: derived at column level, same logic for all rows.\nSection columns: derived per section under one declaration, in every section.\nNote: rows fixed by sections, count unchanged.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sections: each builds its rows separately; concatenated in order, must satisfy keys.\nShared columns: derived at column level, same logic for all rows.\nSection columns: derived per section under one declaration, in every section.\nNote: rows fixed by sections, count unchanged.",
      "autoResize": true,
      "lineHeight": 1.25
    },
