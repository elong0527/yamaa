{
  "name": "yamaa",
  "image": "rocker/r-ver:latest",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode"
    },
    // Moby (moby-cli) is not shipped for Ubuntu resolute, which the floating
    // rocker/r-ver image now uses, so install Docker CE instead: the Nov 10
    // prebuild rebuild failed on the default (moby: true).
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "libreoffice-writer-nogui,fonts-liberation"
    }
  },
  "workspaceFolder": "/workspaces",
  "remoteUser": "vscode",
  "overrideCommand": true,
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteEnv": {
    "PATH": "/workspaces/${localWorkspaceFolderBasename}/python/.venv/bin:/home/vscode/.local/bin:${containerEnv:PATH}",
    "R_LIBS_USER": "/home/vscode/R/library",
    "CARGO_BUILD_JOBS": "2"
  },
  "updateContentCommand": "bash /workspaces/${localWorkspaceFolderBasename}/.devcontainer/setup.sh",
  "waitFor": "updateContentCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "REditorSupport.r",
        "rust-lang.rust-analyzer",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "elong0527.vs-rtf-preview"
      ],
      "settings": {
        "r.rterm.linux": "/usr/local/bin/R",
        // Off, so that the Python extension resolves
        // python.defaultInterpreterPath itself. With it on, the Python
        // Environments extension answers "no environment" until its discovery
        // ends, and on a new Codespace's first open the Python extension
        // reports that as an invalid interpreter
        // (microsoft/vscode-python-environments#1858).
        "python.useEnvironmentsExtension": false
      }
    }
  }
}
