# Preserve the installed third-party notice bytes on every platform.
R/yamaa/inst/LICENSE-UNICODE.txt text eol=lf
# Keep the generated schema Unicode table's byte-exact reproduction portable.
rust/crates/yamaa-core/src/schema/printable_data.rs text eol=lf
# Keep the committed facade API inventory byte-identical on every platform.
rust/crates/yamaa/public-api.txt text eol=lf
# Keep vendored release sources and both installed MIT notices byte-identical.
rust/vendor/saphyr-parser/** text eol=lf
rust/vendor/parquet/** text eol=lf
python/LICENSE-YAML.txt text eol=lf
R/yamaa/inst/LICENSE-YAML.txt text eol=lf
# Unified diff context represents an empty source line with one leading space.
rust/vendor/saphyr-parser/compact-flow-pairs.patch whitespace=-blank-at-eol
rust/vendor/parquet/omit-column-orders.patch whitespace=-blank-at-eol

# Preserve authored benchmark CSV fixture bytes on every platform.
benchmarks/**/expected/*.csv text eol=lf
